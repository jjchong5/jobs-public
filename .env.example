# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE:
#   1. Copy it to a new file named exactly ".env" (no ".example") in the
#      project's root folder.
#   2. Replace each blank after "=" with your own real value -- e.g. change
#      "ANTHROPIC_API_KEY=" to something like
#      "ANTHROPIC_API_KEY=sk-ant-api03-abc123...". A key left blank, or left
#      as literal placeholder text like "your-key-here", will NOT work --
#      you need an actual key from the provider's own website.
#   3. ANTHROPIC_API_KEY is only needed for the LLM tagging/ranking stage.
#      Scraping, ingest, and browsing raw results in the UI all work with
#      this left blank -- see docs/RUNNING_WITHOUT_ANTHROPIC.md. Every other
#      variable below is optional and only needed if you're using that
#      specific source/feature -- leave the rest blank to start.
# ---------------------------------------------------------------------------

# OPTIONAL -- get a key at https://console.anthropic.com (used by the LLM
# tagger to classify/score scraped postings). Leave blank to run the
# scraper/ingest/UI without tagging or ranking -- see
# docs/RUNNING_WITHOUT_ANTHROPIC.md for exactly what still works and what
# doesn't.
ANTHROPIC_API_KEY=

# OPTIONAL -- only needed for Apify-hosted scrapers (Indeed, LinkedIn,
# Wellfound). Get a token at https://apify.com after creating a free
# account. Leave blank to skip those sources -- see docs/CHANGING_LOCATION.md
# and docs/SOURCES.md for which sources need this vs. which don't.
APIFY_API_TOKEN=

# OPTIONAL -- Telegram run-summary notifications (src/pipeline/notifications/).
# To use: message @BotFather on Telegram to create a new bot and get a bot
# token, then send your new bot any message and fetch
# https://api.telegram.org/bot<token>/getUpdates in a browser to find your
# numeric TELEGRAM_CHAT_ID. Notifications are skipped (logged, not fatal) if
# either is unset -- safe to leave blank.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tagger provider selection (see src/pipeline/tagger/providers.py). Default is
# "anthropic" if unset -- only set this to "glm" once GLM_API_KEY below is a real
# key and you've smoke-tested tag_item.py's __main__ against it.
TAGGER_PROVIDER=anthropic
GLM_API_KEY=

# OPTIONAL -- Luma events scraper (currently frozen/off by default, see
# CLAUDE.md "Current State"). Not needed unless you re-enable it.
LUMA_API_KEY=

# ---------------------------------------------------------------------------
# Location / search customization -- see docs/CHANGING_LOCATION.md for a full
# beginner-friendly walkthrough. All of these are OPTIONAL: leave blank to
# use each source's default (San Francisco, CA / Bay Area).
# ---------------------------------------------------------------------------

# LinkedIn (linkedin_apify.py) -- paste a full LinkedIn job-search URL here
# (copy it from your browser after searching linkedin.com/jobs yourself);
# see docs/CHANGING_LOCATION.md for step-by-step instructions.
APIFY_LINKEDIN_SEARCH_URL=
APIFY_LINKEDIN_SEARCH_URLS=
APIFY_LINKEDIN_MAX_ITEMS=

# Indeed -- indeed_apify_old.py (frozen/fallback source, off by default)
APIFY_INDEED_POSITION=
APIFY_INDEED_LOCATION=
APIFY_INDEED_MAX_ITEMS=

# Indeed radius search -- indeed_radius.py (live default source; this is the
# one actually in use today, distinct from the frozen vars above)
APIFY_INDEED_RADIUS_POSITION=
APIFY_INDEED_RADIUS_LOCATION=
APIFY_INDEED_RADIUS_MILES=
APIFY_INDEED_RADIUS_MAX_JOBS=

# Wellfound -- wellfound_apify_old.py (frozen/fallback source, off by default)
APIFY_WELLFOUND_START_URL=
APIFY_WELLFOUND_MAX_ITEMS=

# Wellfound search -- wellfound_search_apify.py (live default source; this
# is the one actually in use today). WELLFOUND_SEARCH_LOCATION uses
# Wellfound's own city URL slug, e.g. "austin"
WELLFOUND_SEARCH_ROLES=
WELLFOUND_SEARCH_LOCATION=
WELLFOUND_SEARCH_PAGE_LIMIT=

# Dice -- dice.py (live default source)
DICE_QUERY=
DICE_LOCATION=

# Read-only MCP server (src/pipeline/mcpserver/) exposing item search/rank/
# export to external humans/agents. MCP_SERVER_PORT defaults to 8420 if
# unset. PIPELINE_DB_REMOTE_PATH points at a local snapshot of a remote
# always-on host's pipeline.db (SQLite has no live remote-file story --
# "remote" here means "last synced via sync_remote_db.py", not a live
# connection); defaults to data/pipeline_mini_snapshot.db if that file
# exists, else falls back to the local data/pipeline.db. Neither var needs
# to be set for local dev against your own local DB.
MCP_SERVER_PORT=8420
PIPELINE_DB_REMOTE_PATH=
# Comma-separated extra Host headers to allow through the MCP SDK's
# DNS-rebinding protection (127.0.0.1/localhost are always allowed).
# Set this to your current ngrok domain or real hosting domain, e.g.
# MCP_ALLOWED_HOSTS=attest-sled-flock.ngrok-free.dev
MCP_ALLOWED_HOSTS=
